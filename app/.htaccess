# The application folder must never be reachable over HTTP.
# Legacy "/app/..." URLs are already redirected by the root .htaccess,
# so this folder only needs to be locked down (same as system/ and writable/).
<IfModule authz_core_module>
	Require all denied
</IfModule>
<IfModule !authz_core_module>
	Deny from all
</IfModule>
